#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/* ===================================================
   カーソル加速度（動的スケーラー）の定義
   =================================================== */
/ {
    zip_xy_accel: zip_xy_accel {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        code = <INPUT_REL_XY>;
    };
};

&zip_temp_layer {
    excluded-positions = <
        15 // H copy
        16 // J left
        17 // K middle
        18 // L right
        27 // N paste
        28 // M prev
        30 // . next
    >;
};

&pointing_listener {
    input-processors = <
        &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
        &zip_xy_accel 2 1
        &zip_temp_layer 1 800
    >;
    //レイヤー1をオートマウスレイヤに設定 800msec有効

    slow_pointer {
        layers = <9>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
            &zip_xy_scaler 1 2
        >;
    };

    scroller {
        layers = <8>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_scaler 1 5
            &zip_scroll_transform INPUT_TRANSFORM_X_INVERT
        >;
    };
};

&size_s_transform {
    col-offset = <7>;
};

&size_m_transform {
    col-offset = <7>;
};

&size_l_transform {
    col-offset = <7>;
};
